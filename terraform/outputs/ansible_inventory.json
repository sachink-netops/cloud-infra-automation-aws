terraform output -json web_instance_public_ips \
  | jq -r '
      [.web_instance_public_ips[] |
        {
          "host": .,
          "public_ip": .,
          "ansible_connection": "ssh",
          "ansible_user": "ec2-user",
          "ansible_ssh_private_key_file": "~/.ssh/id_ed25519"
        }
      ]' \
  | jq '{ "all": { "children": { "web_servers": { "hosts": (map({ (.host): . }) | add) } } } }' \
  > ansible_inventory.json
